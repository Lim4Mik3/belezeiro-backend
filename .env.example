# ==========================================
# BELEZEIRO BACKEND - GLOBAL ENVIRONMENT VARIABLES
# ==========================================
# This file aggregates ALL environment variables from all modules
# Use this for MONOLITH deployment (local development with server module)
# For Lambda deployment, variables are loaded from AWS SSM Parameter Store
# Copy this file to .env and fill in the values
# ==========================================

# ==========================================
# CORE MODULE (@core)
# ==========================================

# Node Environment
NODE_ENV=development

# Upstash Redis Configuration (Serverless)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Event Bus Configuration
EVENT_BUS_TYPE=redis
EVENT_BUS_RETRY_ATTEMPTS=3
EVENT_BUS_RETRY_DELAY=1000

# ID Generation
ID_GENERATOR_TYPE=ulid

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ==========================================
# IAM MODULE (@iam)
# ==========================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-min-32-chars-here-change-this
SESSION_MAX_AGE_HOURS=24

# ==========================================
# BUSINESS MODULE (@business)
# ==========================================

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/belezeiro
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Business Settings
MAX_UNITS_PER_BUSINESS=100
BUSINESS_NAME_MAX_LENGTH=100

# ==========================================
# SERVER MODULE (MONOLITH ONLY)
# ==========================================

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
