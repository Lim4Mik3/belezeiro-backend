{
  "name": "belezeiro-backend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:all",
    "build": "bun run build:all",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ui": "bun test --coverage --coverage-reporter=html",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@upstash/redis": "^1.35.6",
    "mongodb": "^7.0.0",
    "ulidx": "^2.4.1",
    "zod": "^4.1.13"
  }
}